+    fn relative_rect(&self, node: NodeId) -> CGRect {
+        let mut path = vec![node];
+        let mut current = node;
+        while let Some(parent) = current.parent(&self.tree.map) {
+            path.push(parent);
+            current = parent;
+        }
+        let mut rect = CGRect::new(CGPoint::new(0.0, 0.0), CGSize::new(1.0, 1.0));
+        for pair in path.windows(2).rev() {
+            let [child, parent] = pair else { continue };
+            let Some(NodeKind::Split { orientation, ratio }) = self.kind.get(*parent) else {
+                continue;
+            };
+            let ratio = f64::from(*ratio);
+            let is_first = parent.first_child(&self.tree.map) == Some(*child);
+            match orientation {
+                Orientation::Horizontal => {
+                    let first_width = rect.size.width * ratio;
+                    if is_first {
+                        rect.size.width = first_width;
+                    } else {
+                        rect.origin.x += first_width;
+                        rect.size.width -= first_width;
+                    }
+                }
+                Orientation::Vertical => {
+                    let first_height = rect.size.height * ratio;
+                    if is_first {
+                        rect.size.height = first_height;
+                    } else {
+                        rect.origin.y += first_height;
+                        rect.size.height -= first_height;
+                    }
+                }
+            }
+        }
+        rect
+    }
+
+    fn node_size(&self, layout: LayoutId, node: NodeId) -> Option<CGSize> {
+        let tiling = self.tiling_sizes.borrow().get(&layout).copied()?;
+        let root = self.layouts.get(layout)?.root;
+        if !node.ancestors(&self.tree.map).any(|ancestor| ancestor == root) {
+            return None;
+        }
+        let relative = self.relative_rect(node).size;
+        Some(CGSize::new(
+            tiling.width * relative.width,
+            tiling.height * relative.height,
+        ))
+    }
+
+    fn edge_point(&self, node: NodeId, direction: Direction) -> CGPoint {
+        let rect = self.relative_rect(node);
+        let (x, y, width, height) = (rect.origin.x, rect.origin.y, rect.size.width, rect.size.height);
+        match direction {
+            Direction::Left => CGPoint::new(x, y + height / 2.0),
+            Direction::Right => CGPoint::new(x + width, y + height / 2.0),
+            Direction::Up => CGPoint::new(x + width / 2.0, y),
+            Direction::Down => CGPoint::new(x + width / 2.0, y + height),
+        }
+    }
+
+    fn orientation_for_shape(&self, layout: LayoutId, node: NodeId) -> Option<Orientation> {
+        self.node_size(layout, node).map(|size| {
+            if size.width > size.height {
+                Orientation::Horizontal
+            } else {
+                Orientation::Vertical
+            }
+        })
+    }
