+    fn node_size(&self, layout: LayoutId, node: NodeId) -> Option<CGSize> {
+        let mut size = self.tiling_sizes.borrow().get(&layout).copied()?;
+        let mut path = vec![node];
+        let mut current = node;
+        while let Some(parent) = current.parent(&self.tree.map) {
+            path.push(parent);
+            current = parent;
+        }
+        if self.layouts.get(layout).map(|state| state.root) != Some(current) {
+            return None;
+        }
+        for pair in path.windows(2).rev() {
+            let [child, parent] = pair else { continue };
+            let Some(NodeKind::Split { orientation, ratio }) = self.kind.get(*parent) else {
+                continue;
+            };
+            let ratio = f64::from(*ratio);
+            let share = if parent.first_child(&self.tree.map) == Some(*child) {
+                ratio
+            } else {
+                1.0 - ratio
+            };
+            match orientation {
+                Orientation::Horizontal => size.width *= share,
+                Orientation::Vertical => size.height *= share,
+            }
+        }
+        Some(size)
+    }
+
+    fn orientation_for_shape(&self, layout: LayoutId, node: NodeId) -> Option<Orientation> {
+        self.node_size(layout, node).map(|size| {
+            if size.width > size.height {
+                Orientation::Horizontal
+            } else {
+                Orientation::Vertical
+            }
+        })
+    }
+
+    fn has_ancestor_split_along(&self, node: NodeId, orientation: Orientation) -> bool {
+        let mut current = node;
+        while let Some(parent) = current.parent(&self.tree.map) {
+            if matches!(
+                self.kind.get(parent),
+                Some(NodeKind::Split { orientation: o, .. }) if *o == orientation
+            ) {
+                return true;
+            }
+            current = parent;
+        }
+        false
+    }
+
+    fn move_to_layout_edge(&mut self, layout: LayoutId, moving: NodeId, direction: Direction) -> bool {
+        let orientation = direction.orientation();
+        let Some(root) = self.layouts.get(layout).map(|state| state.root) else {
+            return false;
+        };
+        let Some(old_parent) = moving.parent(&self.tree.map) else {
+            return false;
+        };
+        if self.has_ancestor_split_along(moving, orientation) {
+            return false;
+        }
+
+        let holder = self.tree.mk_node().into_id();
+        moving.detach(&mut self.tree).push_back(holder);
+        self.collapse_split(old_parent);
+
+        let rest = self.tree.mk_node().into_id();
+        let root_children: Vec<_> = root.children(&self.tree.map).collect();
+        for child in root_children {
+            child.detach(&mut self.tree).push_back(rest);
+        }
+        if let Some(root_kind) = self.kind.get(root).cloned() {
+            self.kind.insert(rest, root_kind);
+        }
+        if let Some(stack) = self.stacks.remove(&root) {
+            self.stacks.insert(rest, stack);
+        }
+        self.kind.insert(root, NodeKind::Split { orientation, ratio: 0.5 });
+
+        let (first, second) = match direction {
+            Direction::Left | Direction::Up => (moving, rest),
+            Direction::Right | Direction::Down => (rest, moving),
+        };
+        first.detach(&mut self.tree).push_back(root);
+        second.detach(&mut self.tree).push_back(root);
+        holder.remove_root(&mut self.tree);
+        true
+    }
